# Nunca inclua credenciais reais neste arquivo.
PROVIDER_LLM=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_REGION=us-east-1
# AWS usa a cadeia padrão do SDK: perfil, IAM role ou variáveis AWS_*.
OLLAMA_BASE_URL=http://localhost:11434

GITHUB_APP_ID=
# Escolha um caminho de chave local ou GITHUB_APP_PRIVATE_KEY (PEM).
GITHUB_APP_PRIVATE_KEY_PATH=./chave_git.pem

GITHUB_TIMEOUT=20
LLM_TIMEOUT=90
MAX_ATTEMPTS=3
RETRY_DELAY=1
MAX_FILES=100
MAX_FILE_BYTES=65536
MAX_TOTAL_BYTES=2097152
MAX_TREE_ENTRIES=20000
MAX_TREE_REQUESTS=200
INPUT_TOKEN_BUDGET=16000
OUTPUT_TOKEN_BUDGET=4096
MODEL_CONTEXT_TOKENS=32768
ASSESSMENT_OUTPUT_DIR=outputs/assessments

# Opcionais; apenas metadados operacionais, sem prompts/código bruto.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
